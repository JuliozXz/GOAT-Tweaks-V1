<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GOAT Tweaks · GPU Center" Width="1240" Height="820" MinWidth="960" MinHeight="620" Background="#0C0D10" Foreground="#ECECED" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#E4B95B"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#292B31"/><Setter Property="Foreground" Value="#FAFAFA"/><Setter Property="BorderBrush" Value="#3A3B42"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#14161B"/><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="BorderBrush" Value="#383A42"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Margin" Value="0,4,8,12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,8,12"/><Setter Property="Padding" Value="9"/><Setter Property="MinWidth" Value="120"/><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#25272E" BorderBrush="#43454F" BorderThickness="1" Padding="10"><TextBlock Text="▾" Foreground="#C3AB76" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="10,9,28,9" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#202228" BorderBrush="#555864" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBackground" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#4C4028"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="Margin" Value="0,8,12,12"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#14161B"/><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2C2B28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#40351F"/><Setter Property="Foreground" Value="#F5D490"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#40351F"/><Setter Property="Foreground" Value="#F5D490"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#14161B"/><Setter Property="Foreground" Value="#E3E3E7"/><Setter Property="RowBackground" Value="#14161B"/><Setter Property="AlternatingRowBackground" Value="#1C1E24"/><Setter Property="BorderBrush" Value="#383A42"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#25272E"/><Setter Property="Foreground" Value="#E4B95B"/><Setter Property="Padding" Value="10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#181A20"/><Setter Property="BorderBrush" Value="#2A2D35"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,12,16"/></Style>
  <Style x:Key="Readout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14161B" BorderBrush="#292C34" BorderThickness="0,0,1,0"><DockPanel Margin="16,22,16,16">
   <StackPanel DockPanel.Dock="Top"><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#080808" CornerRadius="8" Width="52" Height="52"><Image x:Name="AppLogo" Width="50" Height="50" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Logo GOAT Tweaks" AutomationProperties.Name="Logo GOAT Tweaks"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="GOAT" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Gold}"/><TextBlock Text="TWEAKS · BY JULIO" FontSize="9" Foreground="#A9ACB8" Margin="0,3,0,0"/></StackPanel></Grid><TextBlock x:Name="ModeLabel" Text="7.4.1 · EDIÇÃO OFICIAL" FontSize="9" Foreground="#C7B583" Margin="0,0,0,20"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="Diagnóstico com contexto.&#10;Cada resultado precisa de evidência." FontSize="10" Foreground="#90939F" Margin="0,15,0,0"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox x:Name="Navigation"/></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#292C34" BorderThickness="0,0,0,1" Padding="26,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SessionLabel" FontSize="10" Foreground="#9D9FA8" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="↻ Analisar PC"/><Button x:Name="CancelReadButton" Content="Cancelar leitura" Visibility="Collapsed"/><Button x:Name="ExportButton" Content="Exportar relatório"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1" Margin="26,22,14,12">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Seu hardware. Decisões com contexto." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="A análise lê o Windows. Nenhum ajuste é aplicado ao abrir o aplicativo." Foreground="#A9ACB8" Margin="0,0,0,22"/>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROCESSADOR" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock x:Name="CpuSummary" Text="Aguardando leitura" FontSize="17" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GPU / DRIVER" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock x:Name="GpuSummary" Text="Aguardando leitura" FontSize="17" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMÓRIA" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock x:Name="MemorySummary" Text="Aguardando leitura" FontSize="17" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WINDOWS / CONTEXTO" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock x:Name="OsSummary" Text="Aguardando leitura" FontSize="17" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
     <TextBlock Text="Plano de atendimento" FontSize="19" Margin="0,6,0,14"/><StackPanel x:Name="DiagnosisPanel"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recursos desta versão" Foreground="{StaticResource Gold}"/><TextBlock Text="Inventário e diagnóstico · GPU Center · perfis contextuais · importação de frametimes · relatórios e reversão · catálogo e documentação pesquisáveis. Preferências nativas reversíveis, planos de energia existentes e 50 procedimentos avançados. Revise cada mudança antes de aplicar." Margin="0,9,0,0" Foreground="#B2B5C0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ServicePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sessão de atendimento" FontSize="21"/><TextBlock Text="Defina o objetivo e registre o contexto antes de revisar o plano." Foreground="#A9ACB8" Margin="0,10,0,14"/><TextBlock Text="Objetivo"/><ComboBox x:Name="ObjectiveBox"/><TextBlock Text="Modo de atendimento"/><ComboBox x:Name="ServiceModeBox"/><CheckBox x:Name="ConsentBox" Content="Cliente autorizou registrar diagnóstico local e preparar o plano"/><Button x:Name="SaveSessionButton" Content="Salvar contexto" HorizontalAlignment="Left"/><TextBlock x:Name="SessionDetails" Foreground="#A9ACB8" Margin="0,10,0,16"/><WrapPanel><Button x:Name="NewSessionButton" Content="Nova sessão"/><Button x:Name="ResumeButton" Content="Retomar sessão salva"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Finalizar serviço" FontSize="21"/><TextBlock Text="Confira o histórico. A finalização valida o relatório e o pacote privado de reversão antes de encerrar a sessão. Ajustes persistentes não dependem deste app portátil. Diários e relatórios são preservados; não há serviços ou tarefas instalados para remover." Foreground="#A9ACB8" Margin="0,10,0,15"/><Button x:Name="FinishButton" Content="Revisar e finalizar serviço" Background="{StaticResource Gold}" Foreground="#111111" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid x:Name="CatalogPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Catálogo integral com fonte e acesso ao recurso disponível. A classe original permanece no detalhe." Foreground="#A9ACB8"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBox x:Name="CatalogSearch" ToolTip="Buscar por título, ID ou explicação"/><ComboBox x:Name="CategoryBox" Grid.Column="1"/><ComboBox x:Name="ClassBox" Grid.Column="2"/></Grid><TextBlock x:Name="CatalogCount" Foreground="{StaticResource Gold}" Margin="0,0,0,10"/></StackPanel><DataGrid x:Name="CatalogGrid" Grid.Row="1" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding id}" Width="165"/><DataGridTextColumn Header="CONFIGURAÇÃO" Binding="{Binding title}" Width="*"/><DataGridTextColumn Header="RECURSO" Binding="{Binding RuntimeMode}" Width="155"/><DataGridTextColumn Header="RISCO" Binding="{Binding risk}" Width="110"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2"><Button x:Name="CatalogOpenButton" Content="Abrir recurso selecionado" DockPanel.Dock="Bottom" HorizontalAlignment="Left" IsEnabled="False"/><TextBox x:Name="CatalogDetail" Style="{StaticResource Readout}"/></DockPanel></Grid>
    <Grid x:Name="GpuPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="GPU CENTER" Foreground="{StaticResource Gold}" FontSize="12"/><TextBlock Text="Driver instalado e telemetria com fonte. A versão mais recente exige consulta ao fabricante/OEM." Foreground="#A9ACB8" Margin="0,8,0,12"/></StackPanel><TextBox x:Name="GpuDetail" Grid.Row="1" Style="{StaticResource Readout}"/><WrapPanel Grid.Row="2"><ComboBox x:Name="GpuVendorBox"/><Button x:Name="DriverLinkButton" Content="Drivers oficiais ↗"/><Button x:Name="OemLinkButton" Content="Suporte OEM ↗" IsEnabled="False"/><Button x:Name="GpuGuideButton" Content="Guia do fabricante / recuperação"/></WrapPanel></Grid>
    <ScrollViewer x:Name="ProfilesPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Perfil por jogo · hipóteses para comparar" FontSize="21"/><TextBlock Text="O perfil registra contexto e conflitos. Não escreve preferências globais do driver ou do jogo." Foreground="#A9ACB8" Margin="0,10,0,14"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Identificador inequívoco (launcher:ID)"/><TextBox x:Name="GameIdBox"/><TextBlock Text="Nome do jogo"/><TextBox x:Name="GameNameBox"/><TextBlock Text="Executável autorizado (opcional)"/><TextBox x:Name="GamePathBox"/><CheckBox x:Name="GamePathConsent" Content="Autorizo registrar este caminho local"/><TextBlock Text="GPU confirmada para o jogo"/><ComboBox x:Name="ProfileGpuBox"/></StackPanel><StackPanel><TextBlock Text="Objetivo"/><ComboBox x:Name="ProfileGoalBox"/><TextBlock Text="Resolução confirmada / Hz"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ResolutionBox" Width="160" ToolTip="Exemplo: 1920x1080"/><TextBox x:Name="HzBox" Width="100" ToolTip="0 = desconhecido" Text="0"/></StackPanel><TextBlock Text="Reflex / VRR / V-Sync confirmados"/><WrapPanel><ComboBox x:Name="ReflexBox"/><ComboBox x:Name="VrrBox"/><ComboBox x:Name="VSyncBox"/></WrapPanel><TextBlock Text="Limite FPS confirmado (0 = desconhecido)"/><TextBox x:Name="FpsBox" Text="0"/><CheckBox x:Name="CaptureBox" Content="Preservar captura / streaming"/></StackPanel></UniformGrid><WrapPanel><Button x:Name="ProfilePreviewButton" Content="Analisar conflitos"/><Button x:Name="ProfileSaveButton" Content="Salvar perfil local"/><Button x:Name="ProfileImportButton" Content="Importar perfil local"/></WrapPanel><TextBox x:Name="ProfileDetail" Style="{StaticResource Readout}" MinHeight="220"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ActionsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Preferências nativas · aplicação e reversão" FontSize="21"/><TextBlock Text="Escolha preferências, confira compatibilidade e o valor original na prévia. O app grava somente os valores apresentados e verifica a leitura. Ações de aprovação individual devem ser executadas uma por vez. O estado efetivo e o efeito em desempenho exigem conferir o Windows e medir." Foreground="#A9ACB8" Margin="0,10,0,15"/><ListBox x:Name="ActionsList" DisplayMemberPath="Title" SelectionMode="Extended" MaxHeight="210" MinHeight="100"/><ComboBox x:Name="DirectionBox" HorizontalAlignment="Left"/><Button x:Name="PreviewButton" Content="Pré-visualizar seleção" HorizontalAlignment="Left"/><TextBox x:Name="ActionDetail" Style="{StaticResource Readout}" MinHeight="200"/><CheckBox x:Name="ActionConsent" Content="Revisei a prévia e autorizo somente as mudanças selecionadas"/><Button x:Name="ApplyButton" Content="Aplicar seleção revisada" HorizontalAlignment="Left" Background="{StaticResource Gold}" Foreground="#111111" IsEnabled="False"/></StackPanel></ScrollViewer>
    <Grid x:Name="AdvancedPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Procedimentos avançados" FontSize="21"/><TextBlock Text="Os 50 itens antes bloqueados estão aqui com etapas, fontes e recuperação. Procedimentos assistidos são feitos pelo técnico; itens sem controle compatível confirmado mostram o que falta. Registrar uma etapa não comprova alteração nem ganho de desempenho." Foreground="#A9ACB8" Margin="0,10,0,8"/><WrapPanel><CheckBox x:Name="LocalOperatorCheck" Content="Operador presente no PC"/><CheckBox x:Name="RecoveryPlanCheck" Content="Plano de recuperação conferido"/></WrapPanel></StackPanel><ListBox x:Name="AdvancedList" Grid.Row="1" DisplayMemberPath="Title"/><TextBox x:Name="AdvancedDetail" Grid.Row="2" Style="{StaticResource Readout}"/><StackPanel Grid.Row="3"><WrapPanel><Button x:Name="AdvancedSettingsButton" Content="Abrir Configurações" IsEnabled="False"/><Button x:Name="AdvancedSourceButton" Content="Consultar fonte oficial ↗" IsEnabled="False"/></WrapPanel><WrapPanel><CheckBox x:Name="ManualDoneCheck" Content="Realizei este procedimento e conferi o resultado manualmente"/><Button x:Name="ManualRecordButton" Content="Registrar etapa manual" IsEnabled="False"/></WrapPanel></StackPanel></Grid>
    <ScrollViewer x:Name="PowerPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Planos de energia existentes" FontSize="21"/><TextBlock Text="Selecione um plano que já existe neste Windows. A troca pode mudar consumo, calor, bateria e suspensão. O app registra o GUID original e permite restaurá-lo; não cria nem remove planos. Alterações reais exigem administrador e atendimento local confirmado." Foreground="#A9ACB8" Margin="0,10,0,12"/><TextBlock x:Name="PowerCurrentText" Foreground="{StaticResource Gold}" Margin="0,0,0,10"/><WrapPanel><ComboBox x:Name="PowerPlanBox" DisplayMemberPath="Name" MinWidth="260"/><Button x:Name="PowerRefreshButton" Content="Ler planos"/><Button x:Name="PowerPreviewButton" Content="Pré-visualizar plano"/></WrapPanel><TextBox x:Name="PowerDetail" Style="{StaticResource Readout}" MinHeight="190"/><CheckBox x:Name="PowerConsent" Content="Revisei consumo, suspensão e recuperação e autorizo esta troca individual"/><Button x:Name="PowerApplyButton" Content="Aplicar plano revisado" IsEnabled="False" HorizontalAlignment="Left" Background="{StaticResource Gold}" Foreground="#111111"/><TextBlock Text="Histórico de energia / recuperação" FontSize="17" Margin="0,15,0,8"/><TextBox x:Name="PowerHistoryDetail" Style="{StaticResource Readout}" MinHeight="120"/><WrapPanel><ComboBox x:Name="PowerTransactionBox" DisplayMemberPath="Id" MinWidth="280"/><Button x:Name="PowerRestoreButton" Content="Restaurar plano original"/></WrapPanel></StackPanel></ScrollViewer>
    <Grid x:Name="BenchmarksPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Benchmark com dados originais" FontSize="21"/><TextBlock Text="Importe CSV FrameTimeMs ou msBetweenPresents. Registre as mesmas condições e 3–5 passes por condição. Nenhuma captura, stress ou jogo é iniciado pelo app." Foreground="#A9ACB8" Margin="0,10,0,12"/><TextBlock Text="Condições da captura (JSON; todos os campos obrigatórios)"/><TextBox x:Name="ConditionsBox" MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox x:Name="StabilityCheck" Content="Conferi estabilidade, temperaturas e recursos exigidos nas duas condições"/><WrapPanel><ComboBox x:Name="ConditionLabelBox"/><Button x:Name="ImportCaptureButton" Content="Importar CSV de frametimes"/><Button x:Name="CompareButton" Content="Comparar antes / depois"/><Button x:Name="ClearCapturesButton" Content="Nova comparação"/></WrapPanel></StackPanel><TextBox x:Name="BenchmarkDetail" Grid.Row="1" Style="{StaticResource Readout}"/></Grid>
    <Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Transações e recuperação · selecione uma transação para revisar antes de restaurar" Foreground="#A9ACB8" Margin="0,0,0,12"/><TextBox x:Name="HistoryDetail" Grid.Row="1" Style="{StaticResource Readout}"/><WrapPanel Grid.Row="2"><ComboBox x:Name="TransactionBox" DisplayMemberPath="Id"/><Button x:Name="RestoreButton" Content="Restaurar original selecionado"/></WrapPanel></Grid>
    <Grid x:Name="DocumentsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Biblioteca integral do pacote · documentos são texto de referência, nunca código executado" Foreground="#A9ACB8"/><TextBox x:Name="DocumentSearch" ToolTip="Buscar título e conteúdo"/></StackPanel><ListBox x:Name="DocumentsList" Grid.Row="1" DisplayMemberPath="path"/><TextBox x:Name="DocumentText" Grid.Row="2" Style="{StaticResource Readout}"/></Grid>
    <Grid x:Name="DetailPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DetailIntro" Foreground="#A9ACB8" Margin="0,0,0,12"/><TextBox x:Name="DetailText" Grid.Row="1" Style="{StaticResource Readout}"/></Grid>
   </Grid>
   <Border Grid.Row="2" Background="#14161B" Padding="26,12"><TextBlock x:Name="StatusText" Text="Preparando sessão. Nenhuma alteração automática." FontSize="11" Foreground="#CFBB8F"/></Border>
  </Grid>
 </Grid>
</Window>
