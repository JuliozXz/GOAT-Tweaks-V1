              <Grid Margin="0,22,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CPU" FontSize="10" Foreground="#7D6C9C" Margin="0,3,0,0"/><TextBlock x:Name="CpuName" Grid.Column="1" Text="Identificando processador…" FontSize="12"/><TextBlock Grid.Row="1" Text="GPU" FontSize="10" Foreground="#7D6C9C" Margin="0,10,0,0"/><TextBlock x:Name="GpuName" Grid.Row="1" Grid.Column="1" Text="Identificando placa de vídeo…" FontSize="12" Margin="0,7,0,0"/><TextBlock Grid.Row="2" Text="RAM" FontSize="10" Foreground="#7D6C9C" Margin="0,10,0,0"/><TextBlock x:Name="MemoryName" Grid.Row="2" Grid.Column="1" Text="Identificando memória…" FontSize="12" Margin="0,7,0,0"/></Grid>
