              <Grid Margin="0,18,0,5"><TextBlock x:Name="ChecklistTitle" Text="AJUSTES RECOMENDADOS" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SelectionCount" Text="0 selecionados" Foreground="#756588" FontSize="10" HorizontalAlignment="Right"/></Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="202"><StackPanel x:Name="TweaksPanel"><TextBlock Text="Aguardando o scanner…" Foreground="#65758F" Margin="0,20,0,0"/></StackPanel></ScrollViewer>
