              <Border Background="#0F1420" CornerRadius="8" Padding="12" Margin="0,20,0,0"><StackPanel><TextBlock x:Name="HardwareFootnote" Text="Leituras reais do sistema. Dados indisponíveis aparecem como —." Foreground="#8392AC" FontSize="10"/><TextBlock x:Name="SystemIdentity" Text="" Foreground="#55647F" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
              <Grid><StackPanel><TextBlock Text="OTIMIZADOR DO TÉCNICO" FontSize="10" Foreground="#8C9AB1" FontWeight="SemiBold"/><TextBlock x:Name="OptimizerTitle" Text="Modo Jogo GOAT" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Border Background="#211A30" Padding="8,5" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="ModeBadge" Text="EM REVISÃO" FontSize="9" Foreground="#BA9CDA"/></Border></Grid>
              <Border Background="#0E1320" CornerRadius="8" BorderBrush="#222B3D" BorderThickness="1" Padding="12,11" Margin="0,19,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="JOGO DETECTADO" FontSize="9" Foreground="#64748B"/><TextBlock x:Name="GameName" Text="Aguardando diagnóstico…" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="◈" FontSize="23" Foreground="#725391" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></Border>
