<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MainWindow" Title="GOAT Tweaks v2.2 · Technician Edition" Width="1480" Height="970" MinWidth="1180" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#FFFFFF" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" ResizeMode="CanResizeWithGrip">
