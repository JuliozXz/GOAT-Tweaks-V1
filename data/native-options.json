    {
      "Id": "file-extensions",
      "Category": "Sistema",
      "Title": "Extensões de arquivos no Explorer",
      "Description": "Exibe extensões como .exe, .png e .txt. Facilita identificar tipos de arquivo; não altera associações nem aumenta FPS.",
      "Risk": "Baixo",
      "RequiresRestart": true,
      "MinBuild": 19041,
      "SelectionPolicy": "Manual",
      "OnTargets": [
        {
          "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "Name": "HideFileExt",
          "Exists": true,
          "KeyExisted": true,
          "Value": 0,
          "Type": "DWord"
        }
      ],
      "OffTargets": [
        {
          "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "Name": "HideFileExt",
          "Exists": true,
          "KeyExisted": true,
          "Value": 1,
          "Type": "DWord"
        }
      ],
      "OnLabel": "Ativar",
      "OffLabel": "Desativar",
      "Sources": [
        {
          "RepositoryId": "winutil",
          "ItemId": "file:config/tweaks.json",
          "Url": "https://github.com/ChrisTitusTech/winutil/blob/2f0bdc8fca52e1ebe31a8d98216428061d3f8956/config/tweaks.json",
          "Note": "WPFToggleShowExt usa HideFileExt=0 para mostrar e 1 para ocultar."
        },
        {
          "RepositoryId": "rytunex",
          "ItemId": "file:Helpers/OptimizeSystemHelper.cs",
          "Url": "https://github.com/rayenghanmi/RyTuneX/blob/957885f53beaacfa7322581cafdb9eba5df5726a/Helpers/OptimizeSystemHelper.cs",
          "Note": "ShowFileExtensionsAndHiddenFiles/HideFileExtensionsAndHiddenFiles usam 0/1 para HideFileExt."
        }
      ],
      "Benefit": "Interface"
    },
    {
